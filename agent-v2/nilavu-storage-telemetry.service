[Unit]
Description=Continuously publish NILAVUS storage telemetry
Wants=network-online.target nilavu-metrics.service
After=network-online.target nilavu-metrics.service
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/etc/nilavu-telemetry.env
ExecStart=/usr/bin/python3 /opt/nilavu-dashboard/storage_telemetry_push.py
User=root
Restart=always
RestartSec=10s

[Install]
WantedBy=multi-user.target
